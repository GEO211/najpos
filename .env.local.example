NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Get from Supabase → Settings → API → service_role (NOT your login email)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_CODE=your-admin-code
# Direct connection (may fail on IPv4-only networks)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Pooler connection (recommended) — copy from Supabase → Connect → Transaction pooler
DATABASE_POOLER_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres
# Default owner (override in .env.local; used by npm run db:setup)
ADMIN_EMAIL=admin@haliya.com
ADMIN_PASSWORD=change-this-password
ADMIN_FULL_NAME=HALIYA Admin
# Optional: used by scripts/test-auth.mjs and scripts/test-signup.mjs
TEST_AUTH_EMAIL=owner@example.com
TEST_AUTH_PASSWORD=your-secure-password
TEST_SIGNUP_EMAIL=testuser@example.com
TEST_SIGNUP_PASSWORD=test-password-min-6-chars
